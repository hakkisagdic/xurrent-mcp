##############################################################################
# xurrent-mcp — örnek yapılandırma
#
#   cp .env.example .env
#
# HİÇBİR ŞEY DOLDURMADAN ÇALIŞIR. Varsayılan mock moddur; token istemez,
# internete çıkmaz, fixtures/ klasöründeki veriyi kullanır.
# Ders sunumu için bu haliyle yeterlidir.
##############################################################################


# ─────────────────────────────────────────────────────────────────────────────
# 1) XURRENT ADAPTER
# ─────────────────────────────────────────────────────────────────────────────

# mock  → fixtures/ klasöründen okur, yazmalar bellekte tutulur. Token gerekmez.
# live  → gerçek Xurrent GraphQL API'sine bağlanır.
XURRENT_MODE=mock

# --- live modda ZORUNLU ---

# Personal Access Token veya OAuth access token.
# Wire seviyesinde ikisi aynıdır: Authorization: Bearer <token>
# PAT nasıl alınır: Xurrent UI → kullanıcı menüsü → Personal Access Tokens
XURRENT_TOKEN=

# X-Xurrent-Account header değeri. NUMERİK DEĞİL, kısa slug'dır (örn. "widget", "wdc").
# Settings console → Account Overview bölümünden bulunur.
#
# DİKKAT: iç personelin time entry'leri DIRECTORY ACCOUNT'ta yaşar.
# Yanlış hesabı hedeflemek "kayıt bulunamadı" hatalarının en yaygın sebebidir.
XURRENT_ACCOUNT=

# GraphQL endpoint. Bölgeler: global (varsayılan), au, uk, ch, us
#   https://graphql.xurrent.com        (Global)
#   https://graphql.au.xurrent.com     (Australia)
#   https://graphql.uk.xurrent.com     (United Kingdom)
#   https://graphql.ch.xurrent.com     (Switzerland)
#   https://graphql.us.xurrent.com     (United States)
#   https://graphql.xurrent.qa         (QA)
#   https://graphql.xurrent-demo.com   (Demo)
#
# ⚠️  "eu" DİYE BİR BÖLGE YOKTUR. graphql.eu.xurrent.com wildcard DNS ile çözülür
#     ama TLS hatası verir. Global zaten Avrupa'dır.
XURRENT_GRAPHQL_URL=https://graphql.xurrent.com


# ─────────────────────────────────────────────────────────────────────────────
# 2) MCP PROTOKOL REVİZYONU  ★ bkz. contract/protocol.md
# ─────────────────────────────────────────────────────────────────────────────
#
# Bu repo İKİ protokol revizyonunu birden implemente eder ve farkı ders konusu yapar.
#
#   2026-07-28   Güncel spec. Stateless; handshake yok, session yok.
#                Onay akışı MRTR ile: sunucu InputRequiredResult döner,
#                client isteği yeni bir id ile TEKRARLAR.
#
#   2025-11-25   Önceki spec. initialize handshake'i var.
#                Onay akışı sunucu-başlatmalı elicitation/create ile.
#                ⚠️ Bu desen 2026-07-28'de KALDIRILDI (breaking change).
#
#   both         Yalnızca HTTP transport'ta geçerli: /mcp/v1 ve /mcp/v2 ayrı yollarda.
#                stdio'da geçersizdir — tek süreç tek protokol konuşur.
#
MCP_PROTOCOL=2026-07-28

# MRTR'de sunucu, onay bağlamını `requestState` opak alanında client'a emanet eder.
# Spec bu alanı AÇIKÇA "saldırgan kontrolündeki girdi" sayar: imzalanmazsa client
# onayı değiştirip başka bir ticket'a başka bir süre yazdırabilir.
#
# Boş bırakılırsa süreç başlangıcında rastgele üretilir — sunucu yeniden başlayınca
# bekleyen onaylar geçersiz olur. Bu İSTENEN davranıştır; üretimde sabit bir sır verin.
XURRENT_STATE_SECRET=

# requestState geçerlilik süresi (saniye). Replay penceresini daraltır.
XURRENT_STATE_TTL=300


# ─────────────────────────────────────────────────────────────────────────────
# 3) GÜVENLİK ANAHTARLARI
# ─────────────────────────────────────────────────────────────────────────────

# 1 → HİÇBİR mutation HTTP'ye çıkmaz. Her yazma tool'u planı ve uyarıları döner.
# İlk canlı bağlantıda bunu 1 bırakıp çıktıyı incelemek şiddetle tavsiye edilir.
XURRENT_DRY_RUN=0

# Onay politikası — client onay diyaloğunu desteklemiyorsa ne olacak?
# (v1'de elicitation capability'si yoksa, v2'de MRTR retry'ı yapılmıyorsa)
#
#   closed → VARSAYILAN, güvenli.
#            live modda yazma REDDEDİLİR; mock modda uyarı üretilip devam edilir.
#   open   → onaysız yazılır. YALNIZCA CI/otomasyon için.
#   strict → mock modda DA onay sorulur.
#
# fail-closed bilinçli bir karardır: Xurrent bir system of record'dur ve yanlış
# yazılan bir zaman girişi faturalamaya kadar gider.
#
# `strict` neden var: `closed` ile mock modda onay hiç tetiklenmediği için MRTR'nin
# mutlu yolu (InputRequiredResult → kullanıcıya sor → isteği yeni id ile tekrarla →
# yaz) derste CANLI gösterilemiyor. Sunumda onay akışını göstermek için:
#
#     XURRENT_CONFIRM_POLICY=strict node clients/wizard/wizard.mjs --server ts --step 11
#
XURRENT_CONFIRM_POLICY=closed

# Oluşturulan kayıtların "source" alanı — Xurrent'ta hangi entegrasyonun
# yazdığını görmeyi ve gerekirse toplu temizlemeyi sağlar.
XURRENT_SOURCE=xurrent-mcp


# ─────────────────────────────────────────────────────────────────────────────
# 4) BACKDATING STRATEJİSİ  ★ dersin ana konusu
# ─────────────────────────────────────────────────────────────────────────────
#
# Xurrent'ta bir Request/Task'a zaman yazmanın iki yolu vardır ve ikisi de
# tek başına yetersizdir:
#
#   Yol A  timeEntryCreate            → date/startedAt/person TAM KONTROL,
#                                        ama ticket'a BAĞLANAMAZ
#   Yol B  requestUpdate/taskUpdate   → ticket'a BAĞLAR,
#                                        ama date="bugün", person=authenticated user
#
# Üç strateji bu çatalı üç farklı şekilde çözer:
#
#   two_step    Yol B ile yaz → hemen ardından timeEntryUpdate ile date/startedAt/
#               personId düzelt. Hepsini korur, 2 istek eder, atomik değildir.
#               timeEntryUpdate input'unda assignment ALANI OLMADIĞI için
#               2. adım ticket bağını bozmaz — kısıtı avantaja çeviren nokta budur.
#
#   link_first  Sadece Yol B. Tek istek, atomik, basit.
#               Tarih her zaman BUGÜN olur; T-1 karşılanamaz.
#
#   date_first  Sadece Yol A (TimeAllocation hedefli). Tarih/saat tam doğru,
#               ama kayıt ticket'a bağlanmaz. Ticket bazlı raporlama yapılıyorsa UYGUN DEĞİL.
#
XURRENT_BACKDATE_STRATEGY=two_step

# Kullanıcının girebileceği en eski tarih. İster gereği T-1 ile sınırlı.
# 0 = sadece bugün, 1 = dün de olabilir, 7 = son bir hafta
XURRENT_MAX_BACKDATE_DAYS=1


# ─────────────────────────────────────────────────────────────────────────────
# 5) TAKVİM SAĞLAYICISI
# ─────────────────────────────────────────────────────────────────────────────

# mock   → fixtures/calendar.json (kurulum yok, her zaman çalışır)
# ics    → fixtures/calendar.ics veya CALENDAR_ICS_URL
# google → Google Calendar API v3
# graph  → Microsoft Graph (Microsoft 365 / Outlook)
# auto   → sırayla dener: graph → google → ics → mock
CALENDAR_PROVIDER=mock

CALENDAR_ICS_PATH=./fixtures/calendar.ics
CALENDAR_ICS_URL=

# --- Google Calendar ---
#
# İki yol var:
#
# (a) OAuth kullanıcı onayı — kişisel Gmail hesapları dahil HERKESTE çalışır.
#     Tek seferlik:  node scripts/google-auth.mjs
#     Refresh token ~/.xurrent-mcp/google-token.json dosyasına yazılır ve
#     ÜÇ DİL DE aynı dosyayı okur. (Bu bilinçli bir tasarım: OAuth kütüphanesini
#     üç kez implemente etmek yerine token yenilemeyi düz bir HTTP POST'a indirger.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_PATH=~/.xurrent-mcp/google-token.json
GOOGLE_CALENDAR_ID=primary

# (b) Service account + domain-wide delegation — YALNIZCA Google Workspace.
#     @gmail.com hesaplarında ÇALIŞMAZ.
#     Admin console → Security → Access and data control → API controls →
#     Domain-wide delegation → service account'un NUMERİK client ID'si + scope
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_IMPERSONATE_USER=

# --- Microsoft Graph ---
#
# ⚠️  YAYGIN HATA: Calendars.Read.All etkinlik OKUMAK İÇİN DEĞİLDİR —
#     "tüm kullanıcıların çalışma saatleri ve lokasyonları"nı okur.
#     Doğru izin app-only için de delegated için de: Calendars.Read
#
# Client credentials akışında scope HER ZAMAN https://graph.microsoft.com/.default'tur.
#
# App-only kullanıyorsanız Exchange Online application access policy ile
# uygulamayı bir gruba kısıtlayın; aksi halde tenant'taki HER mailbox'ı okuyabilir:
#   New-ApplicationAccessPolicy -AppId <id> -PolicyScopeGroupId <grup> -AccessRight RestrictAccess
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_IMPERSONATE_USER=


# ─────────────────────────────────────────────────────────────────────────────
# 6) YEREL AYARLAR
# ─────────────────────────────────────────────────────────────────────────────

# IANA saat dilimi. Takvim penceresi bu dilimin YEREL GECE YARILARINA göre kurulur
# ve offset gömülü gönderilir. Çıplak timestamp göndermek sessizce yanlış günü getirir.
XURRENT_TIMEZONE=Europe/Istanbul

# Eşleşmeyen toplantılar için önerilecek varsayılan TimeAllocation
# (mock: "İç toplantılar")
DEFAULT_TIME_ALLOCATION_ID=TW9jay9UaW1lQWxsb2NhdGlvbi8x

# Yuvarlama yönü: nearest | up | down
ROUNDING_MODE=nearest


# ─────────────────────────────────────────────────────────────────────────────
# 7) CHATBOT
# ─────────────────────────────────────────────────────────────────────────────

# LLM sağlayıcısı: GEMINI. (Anthropic yolu kaldırıldı; tek sağlayıcı var.)
#
# Terminal ve web chatbot için gereklidir.
# SADECE MCP sunucusunu Claude Code / Claude Desktop'a takacaksanız GEREKMEZ —
# o durumda LLM'i host uygulama sağlar. Sihirbaz ve atölye de LLM KULLANMAZ.
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.6-flash

# ★ ANAHTARSIZ ÇALIŞTIRMA — sahte Gemini sunucusu
#
# API anahtarınız yoksa chatbot'u yine de uçtan uca çalıştırabilirsiniz.
# GEMINI_BASE_URL'i yerel sahte sunucuya çevirin; istemci kodunda tek satır
# değişmez, çünkü taban adres yapılandırılabilir.
#
#   node tools/fake-gemini/server.mjs --mod otomatik --port 5100
#   GEMINI_BASE_URL=http://127.0.0.1:5100 GEMINI_API_KEY=sahte npm run chat
#
# Modlar:  otomatik (kural tabanlı) · zar (rastgele, --tohum ile tekrarlanabilir)
#          sor (isteği kuyruğa yazar, yanıtı SİZ yazarsınız) · kayit (oynatır)
# Ayrıntı: tools/fake-gemini/README.md
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Web arayüzünün dinleyeceği port (her üç dilde de aynı)
WEB_PORT=8787

# MCP Streamable HTTP transport portu
MCP_HTTP_PORT=8788
