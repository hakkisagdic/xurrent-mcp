<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>XurrentMcp</RootNamespace>
    <AssemblyName>XurrentMcp</AssemblyName>

    <!-- NEDEN: TimeZoneInfo.FindSystemTimeZoneById("Europe/Istanbul") ve Türkçe
         kültür karşılaştırmaları invariant globalization modunda ÇALIŞMAZ.
         macOS'ta IANA saat dilimi adları ancak ICU yüklüyken çözülür. -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- ASP.NET Core (http/web modları) ve konsol modları tek projede yaşıyor. -->
    <UseAppHost>true</UseAppHost>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- NEDEN: Birim testleri ALT KLASÖRDE ayrı bir projede (XurrentMcp.Tests/).
         SDK'nın varsayılan **/*.cs glob'u o klasörü de toplardı ve test dosyaları
         ana uygulamaya derlenirdi (xunit referansı olmadan derleme kırılırdı).
         Bu satır ana projeyi test projesinden yalıtır; dotnet run modları
         (stdio | http | chat | web | wizard | sema-testi) etkilenmez. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);XurrentMcp.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- MCP resmi C# SDK'sı. ModelContextProtocol paketi ModelContextProtocol.Core'u
         transitif olarak getirir; attribute'lar (McpServerTool vb.) Core içindedir. -->
    <PackageReference Include="ModelContextProtocol" Version="2.0.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.0.0" />

    <!-- Güvenilirlik katmanı (contract/reliability.md §8): TS p-retry, Python tenacity,
         C# Polly kullanır — politika TEK, kütüphane ÜÇ. Polly.Core v8'in DelayGenerator'ı
         tam-jitter + Retry-After alt sınırını bize bırakır (Xurrent/RetryPolicy.cs). -->
    <PackageReference Include="Polly.Core" Version="8.5.2" />

    <!-- ★ WP4 — resmî Xurrent GraphQL SDK'sı (YALNIZ C#; TS/Python bilinçli olarak
         elle yazılmış istemcide kalır — ders "vendor SDK vs elle yazılmış, tek sözleşme").
         XURRENT_API=graphql-sdk ile seçilir (Xurrent/SdkLiveAdapter.cs). Varsayılan
         hâlâ elle yazılmış "graphql" yoludur; senaryo kapısı onu ölçmeye devam eder. -->
    <PackageReference Include="Xurrent.GraphQL" Version="1.0.2" />

    <!-- Chatbot (chat/web modları) için LLM istemcisi PAKET DEĞİLDİR:
         Gemini generateContent tek uç noktadır ve HttpClient + System.Text.Json ile
         doğrudan konuşulur (Llm/GeminiClient.cs). Bir SDK, derste göstermek istediğimiz
         wire biçimini saklardı; ayrıca sürüm bağımlılığı getirirdi. -->
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Birim testleri, HTTP'den ayrıştırılmış internal eşleyicileri (GraphCalendarProvider.MapEvent,
         GoogleCalendarProvider.MapEvent) doğrudan çağırır. Bu tipleri public yapmak yerine
         yalnızca test derlemesine açıyoruz: sağlayıcıların dış yüzeyi değişmiyor. -->
    <InternalsVisibleTo Include="XurrentMcp.Tests" />
  </ItemGroup>

</Project>
