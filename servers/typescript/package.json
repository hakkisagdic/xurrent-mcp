{
  "name": "xurrent-mcp-typescript",
  "version": "1.0.0",
  "private": true,
  "description": "Xurrent (ITSM) MCP sunucusu + chatbot — TypeScript implementasyonu",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/mcp/stdio.js",
    "http": "node dist/mcp/http.js",
    "chat": "node dist/agent/cli.js",
    "web": "node dist/agent/web.js",
    "wizard": "node dist/wizard.js",
    "gen:ics": "node dist/gen-ics.js",
    "verify": "node dist/verify.js",
    "test": "node --test \"src/**/*.test.mjs\"",
    "test:schema": "node --test src/llm/schema.test.mjs",
    "probe:protocols": "node scripts/probe-protocols.mjs",
    "probe:state": "node scripts/probe-request-state.mjs"
  },
  "_dependencyNote": "İki MCP SDK kuşağı YAN YANA durur. Bunu mümkün kılan tek şey PAKET ADLARININ FARKLI olmasıdır: v1 @modelcontextprotocol/sdk, v2 @modelcontextprotocol/{core,server,client}. Sürümler SABİTLENMİŞTİR — ders çıktılarının deterministik kalması buna bağlıdır.",
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server": "2.0.0",
    "p-retry": "8.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.0"
  }
}
