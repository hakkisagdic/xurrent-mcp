# sırlar
.env*
# ...ama şablon COMMIT EDİLİR. Negasyon olmadan '.env*' onu da kapsıyor;
# bugün takipte olduğu için görünmüyor, ama silinip yeniden eklenirse
# sessizce ignore edilir ve repo kurulamaz hale gelir.
!.env.example
*.pem
*-token.json

# kişisel Claude Code ayarları (proje ayarları .mcp.json'da, o commit edilir)
# Claude Code yerel çalışma alanı: kişisel izinler ve geçici worktree'ler.
# Repo materyali DEĞİLDİR — CLAUDE.md ise materyaldir ve commit'lidir.
.claude/

# node
node_modules/
dist/
*.tsbuildinfo

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# dotnet
bin/
obj/

# mock modda diske yazılan time entry'ler (XURRENT_MOCK_PERSIST=1)
fixtures/.time-entries.local.json

# üretilmiş .ics (scripts/gen-ics.mjs ile yeniden üretilir)
fixtures/calendar.ics

# sahte Gemini "sor" modunun geçici kuyruğu (kayitlar/ COMMIT EDİLİR — oynatılabilir olsun)
tools/fake-gemini/kuyruk/

# iCloud sync duplikatları
* 2.*
*\ 2/

.DS_Store
